FILEBASE_SIGNATURE_VERSION=v4
FILEBASE_BUCKET=civic-sahai-complaints
CITY_TIMEZONE=Asia/Kolkata
ADMIN_DASHBOARD_MAX_CUSTOM_DAYS=90
ADMIN_DASHBOARD_DEFAULT_SLA_HOURS=72
