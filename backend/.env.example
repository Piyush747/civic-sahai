APP_ENV=development
DATABASE_URL=postgresql+psycopg://civic_sahai:civic_sahai@localhost:5432/civic_sahai
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
GCP_PROJECT_ID=
GCP_REGION=
AI_ENABLED=false
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_SSL_CERTFILE=
KAFKA_SSL_KEYFILE=
KAFKA_SSL_INSECURE=false
KAFKA_COMPLAINT_TOPIC=civic-sahai.complaint-received
KAFKA_CONSUMER_GROUP=civic-sahai.incident-clustering
KAFKA_DEAD_LETTER_TOPIC=civic-sahai.complaint-clustering-dlq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLUSTERING_TOP_K=5
CLUSTERING_MIN_CANDIDATE_SCORE=0.45
CLUSTERING_MAX_DISTANCE_METERS=1000
IMAGE_STORAGE_PROVIDER=filebase
IMAGE_STORAGE_BASE_URL=
IMAGE_STORAGE_LOCAL_DIR=
FILEBASE_ENDPOINT_URL=https://s3.filebase.io
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
